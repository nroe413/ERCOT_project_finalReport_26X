% ut26x.sty -- University of Texas report styling for the 26X white paper.
% Recreates the design language of the UT WSH 8.5x11 report templates
% (BentonSans + GT Sectra, burnt orange / charcoal palette) with
% Overleaf-available equivalents: TeX Gyre Heros (sans) + TeX Gyre Pagella
% (body serif). pdfLaTeX-compatible.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ut26x}[2026/07/27 UT 26X report style]

\RequirePackage[margin=1in,headheight=14pt]{geometry}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{tgpagella}          % body serif (Minion-adjacent)
\RequirePackage{tgheros}            % sans (BentonSans stand-in)
\RequirePackage[T1]{fontenc}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}
\RequirePackage[hidelinks]{hyperref}

% ---- UT brand palette (official hex equivalents of the template swatches) --
\definecolor{utorange}{HTML}{BF5700}   % PMS 159 -- burnt orange
\definecolor{utcharcoal}{HTML}{333F48} % PMS 432 -- charcoal
\definecolor{utteal}{HTML}{00A9B7}     % PMS 320
\definecolor{utblue}{HTML}{005F86}     % PMS 7469
\definecolor{utgreen}{HTML}{579D42}    % PMS 2277
\definecolor{utyellow}{HTML}{EAAB00}   % PMS 116
\definecolor{utlimestone}{HTML}{D6D2C4}% PMS 7527

% ---- section styling: sans, charcoal, burnt-orange number + rule -----------
\titleformat{\section}
  {\sffamily\bfseries\Large\color{utcharcoal}}
  {\textcolor{utorange}{\thesection}}{0.7em}{}
  [{\color{utorange}\titlerule[1.1pt]}]
\titleformat{\subsection}
  {\sffamily\bfseries\large\color{utcharcoal}}
  {\textcolor{utorange}{\thesubsection}}{0.6em}{}
\titleformat{\paragraph}[runin]
  {\sffamily\bfseries\color{utcharcoal}}{}{0em}{}[.]
\titlespacing*{\section}{0pt}{18pt}{8pt}
\titlespacing*{\subsection}{0pt}{12pt}{5pt}

% ---- captions: sans, small, orange label ----------------------------------
\captionsetup{font={sf,small},labelfont={bf,color=utorange},
  textfont={color=utcharcoal},labelsep=period,skip=6pt}

% ---- headers / footers ----------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[L]{\color{utorange}\rule[-0.6ex]{0.18\textwidth}{2.2pt}}
\fancyhead[R]{\sffamily\footnotesize\color{utcharcoal}\MakeUppercase{\ut@shorttitle}}
\fancyfoot[L]{\sffamily\footnotesize\color{utcharcoal}The University of Texas at Austin}
\fancyfoot[R]{\sffamily\footnotesize\color{utcharcoal}\thepage}
\fancypagestyle{plain}{\fancyhf{}%
  \fancyfoot[R]{\sffamily\footnotesize\color{utcharcoal}\thepage}%
  \renewcommand{\headrulewidth}{0pt}}

% ---- cover page -----------------------------------------------------------
\newcommand{\ut@shorttitle}{}
\newcommand{\utshorttitle}[1]{\renewcommand{\ut@shorttitle}{#1}}
\newcommand{\utsubtitle}[1]{\newcommand{\ut@subtitle}{#1}}
\newcommand{\utdateline}[1]{\newcommand{\ut@dateline}{#1}}
\newcommand{\utauthors}[1]{\newcommand{\ut@authors}{#1}}

\newcommand{\utcover}{%
\begin{titlepage}
  \thispagestyle{empty}
  \noindent{\color{utorange}\rule{\textwidth}{6pt}}\par
  \vspace*{0.16\textheight}
  {\raggedright\sffamily\bfseries\color{utcharcoal}\fontsize{30}{36}\selectfont
    \@title\par}
  \vspace{1.4em}
  \ifdefined\ut@subtitle
  {\raggedright\sffamily\color{utorange}\Large \ut@subtitle\par}
  \vspace{0.6em}
  \fi
  {\raggedright\sffamily\color{utcharcoal}\normalsize \ut@authors\par}
  \vfill
  {\raggedright\sffamily\color{utcharcoal}\large \ut@dateline\par}
  \vspace{0.8em}
  {\raggedright\sffamily\bfseries\color{utcharcoal}\large
    The University of Texas at Austin\par}
  {\raggedright\sffamily\color{utcharcoal}\small
    in collaboration with ERCOT\par}
  \vspace{0.5em}
  \noindent{\color{utorange}\rule{\textwidth}{2.2pt}}
\end{titlepage}}

% ---- TOC styling ----------------------------------------------------------
\preto\tableofcontents{%
  \begingroup
  \renewcommand{\contentsname}{\sffamily\bfseries\color{utcharcoal}Table of Contents}}
\appto\tableofcontents{\endgroup}

\endinput