    <Definition classid="UserCmpDefn" name="Electranix_PSSE_Machine" group="" url="" version="" build="" crc="102354046" instances="1" view="false" date="0" id="631384306">
      <paramlist>
        <param name="Description" value="PSSE Compatible Synchronous Machine" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Configuration">
          <parameter type="Text" name="FName" desc="Full pathname of input .DYR file:" group="" helpmode="Append">
            <value><![CDATA[inputfile.dyr]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="Model" desc="Machine Model" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = GENCLS]]></choice>
            <choice><![CDATA[1 = GENDCO]]></choice>
            <choice><![CDATA[2 = GENROE]]></choice>
            <choice><![CDATA[3 = GENROU]]></choice>
            <choice><![CDATA[4 = GENSAE]]></choice>
            <choice><![CDATA[5 = GENSAL]]></choice>
            <choice><![CDATA[7 = GENTPJ*]]></choice>
            <choice><![CDATA[6 = GENTRA]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Integer" name="Bus" desc="Bus Number" group="" helpmode="Append" content_type="Literal" intent="Input" min="" max="" dim="1" unit="">
            <value><![CDATA[1000]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Text" name="Ckt" desc="Circuit Number or Name" group="" helpmode="Append">
            <value><![CDATA[1]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Integer" name="machsw" desc="Source[0] -&gt; Machine[1] transition" group="" helpmode="Append" content_type="Variable" intent="Input" min="0" max="1" dim="1" unit="0-&gt;1only">
            <value><![CDATA[1]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Integer" name="Enab" desc="Lock-rotor[0]&lt;-&gt;Normal mode[1] transition" group="" helpmode="Append" content_type="Variable" intent="Input" min="" max="" dim="1" unit="0or1">
            <value><![CDATA[1]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Vbase" desc="Rated RMS Voltage (kV,LL)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.01" max="" dim="1" unit="kV">
            <value><![CDATA[10.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="MVA" desc="Rated 3 Phase MVA" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.001" max="" dim="1" unit="MVA">
            <value><![CDATA[100.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Fbase" desc="Base Angular Frequency (Hz)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="" dim="1" unit="Hz">
            <value><![CDATA[60]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="MM" desc="Multimass interface:[Enables Speed Ctrl]" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = DISABLE]]></choice>
            <choice><![CDATA[1 = ENABLE]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="SAT" desc="Enable Saturation?" group="" helpmode="Append">
            <value><![CDATA[1]]></value>
            <choice><![CDATA[0 = No, Disable]]></choice>
            <choice><![CDATA[1 = Yes, Enabled]]></choice>
            <regex />
            <error_msg />
            <cond><![CDATA[Model!=0]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="RPU" desc="Source Series R (pu on machine base mva)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="" dim="1" unit="pu">
            <value><![CDATA[0.0]]></value>
            <cond><![CDATA[Model==0]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="XPU" desc="Source Series X (pu on machine base mva, +ve for L)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="" dim="1" unit="pu">
            <value><![CDATA[0.1]]></value>
            <cond><![CDATA[Model==0]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
        <category name="Initial Conditions">
          <parameter type="Real" name="VT" desc="Initial Terminal Voltage Magnitude (pu)" group="" helpmode="Append" content_type="Variable" intent="Input" min="" max="" dim="1" unit="p.u.">
            <value><![CDATA[1.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Pheta" desc="Initial Terminal Voltage Phase (deg)" group="" helpmode="Append" content_type="Variable" intent="Input" min="" max="" dim="1" unit="deg">
            <value><![CDATA[0.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="P0" desc="Initial Terminal Real  Power ; Out + (MW)" group="" helpmode="Append" content_type="Variable" intent="Input" min="" max="" dim="1" unit="MW">
            <value><![CDATA[0.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Q0" desc="Initial Terminal Reactive Power ; Out + (MVAR)" group="" helpmode="Append" content_type="Variable" intent="Input" min="" max="" dim="1" unit="MVAR">
            <value><![CDATA[0.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="RAMPTIME" desc="Time to Ramp Source During Startup (0.1 sec):" group="" helpmode="Append" content_type="Literal" intent="Input" min="" max="" dim="1" unit="sec">
            <value><![CDATA[0.1]]></value>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
        <category name="Output Variable Names">
          <parameter type="Text" name="POut" desc="Name: Real Power;  Out + (p.u.)" group="" helpmode="Append">
            <value><![CDATA[]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Text" name="QOut" desc="Name: Reactive Power;  Out + (p.u.)" group="" helpmode="Append">
            <value><![CDATA[]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Text" name="Vneut" desc="Name: Neutral Voltage (kV)" group="" helpmode="Append">
            <value><![CDATA[]]></value>
            <regex />
            <error_msg />
            <cond><![CDATA[Model!=0]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Text" name="Cneut" desc="Name: Neutral Current to Ground (kA)" group="" helpmode="Append">
            <value><![CDATA[]]></value>
            <regex />
            <error_msg />
            <cond><![CDATA[Model!=0]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Text" name="Lang" desc="Name: Load Angle; Gen. +  (rad)" group="" helpmode="Append">
            <value><![CDATA[]]></value>
            <regex />
            <error_msg />
            <cond><![CDATA[Model!=0]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Text" name="Theta" desc="Name: Rotor Mechanical Angle (rad)" group="" helpmode="Append">
            <value><![CDATA[]]></value>
            <regex />
            <error_msg />
            <cond><![CDATA[Model!=0]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Text" name="Wang" desc="Name: Internal Phase A Angle w.r.t. sin(wt)  (rad)" group="" helpmode="Append">
            <value><![CDATA[]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -200 200 200" size="4">
        <port model="Transfer" name="telect" x="-72" y="0" dim="1" mode="Output" type="Real" internal=""><![CDATA[true]]></port>
        <port model="Transfer" name="speed" x="-36" y="72" dim="1" mode="Output" type="Real" internal=""><![CDATA[true]]></port>
        <port model="Transfer" name="tmeco" x="-72" y="36" dim="1" mode="Output" type="Real" internal=""><![CDATA[true]]></port>
        <port model="Transfer" name="efo" x="-72" y="-72" dim="1" mode="Output" type="Real" internal=""><![CDATA[Model!=0]]></port>
        <port model="Transfer" name="mvit" x="36" y="-72" dim="3" mode="Output" type="Real" internal=""><![CDATA[true]]></port>
        <port model="Transfer" name="cfldn" x="0" y="-72" dim="1" mode="Output" type="Real" internal=""><![CDATA[Model!=0]]></port>
        <port model="Transfer" name="efldn" x="-36" y="-72" dim="1" mode="Input" type="Real" internal=""><![CDATA[Model!=0]]></port>
        <port model="Transfer" name="tmech" x="0" y="72" dim="1" mode="Input" type="Real" internal=""><![CDATA[true]]></port>
        <port model="Transfer" name="Tmstd" x="36" y="72" dim="1" mode="Output" type="Real" internal=""><![CDATA[true]]></port>
        <port model="Natural" name="NS" x="36" y="0" dim="3" mode="" type="NonRemovable" internal="false"><![CDATA[true]]></port>
        <port model="Transfer" name="conspd" x="-72" y="-36" dim="1" mode="Input" type="Real" internal=""><![CDATA[(MM==1)]]></port>
        <port model="Natural" name="Gnd" x="-36" y="0" dim="1" mode="" type="Ground" internal="false"><![CDATA[Model==0]]></port>
