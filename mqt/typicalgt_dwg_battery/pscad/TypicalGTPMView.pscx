    <Definition classid="UserCmpDefn" name="Electranix_PSSE_Governors" group="" url="" version="" build="" crc="8068460" instances="1" view="false" date="0" id="281711676">
      <paramlist>
        <param name="Description" value="PSSE Compatible Governor Models" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Main Data">
          <parameter type="Text" name="FName" desc="Full pathname of input .DYR file:" group="" helpmode="Append">
            <value><![CDATA[..\inputfile.dyr]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="Model" desc="Governor Model" group="" helpmode="Append">
            <value><![CDATA[20]]></value>
            <choice><![CDATA[0 = CRCMGV]]></choice>
            <choice><![CDATA[1 = DEGOV]]></choice>
            <choice><![CDATA[2 = DEGOV1]]></choice>
            <choice><![CDATA[3 = GAST]]></choice>
            <choice><![CDATA[4 = GAST2A]]></choice>
            <choice><![CDATA[5 = GASTWD]]></choice>
            <choice><![CDATA[20 = GGOV1]]></choice>
            <choice><![CDATA[6 = HYGOV]]></choice>
            <choice><![CDATA[135 = HYGOV2]]></choice>
            <choice><![CDATA[7 = IEEEG1]]></choice>
            <choice><![CDATA[8 = IEEEG2]]></choice>
            <choice><![CDATA[9 = IEEEG3]]></choice>
            <choice><![CDATA[10 = IEESGO]]></choice>
            <choice><![CDATA[11 = PIDGOV]]></choice>
            <choice><![CDATA[12 = UNUSED]]></choice>
            <choice><![CDATA[13 = TGOV1]]></choice>
            <choice><![CDATA[14 = TGOV2]]></choice>
            <choice><![CDATA[15 = TGOV3]]></choice>
            <choice><![CDATA[16 = TGOV5]]></choice>
            <choice><![CDATA[17 = WEHGOV]]></choice>
            <choice><![CDATA[18 = WESGOV]]></choice>
            <choice><![CDATA[19 = WPIDHY]]></choice>
            <choice><![CDATA[22 = WSHYDD]]></choice>
            <choice><![CDATA[21 = WSIEG1]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Integer" name="Bus" desc="Bus Number" group="" helpmode="Append" content_type="Literal" intent="Input" min="" max="" dim="1" unit="">
            <value><![CDATA[1000]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Text" name="Ckt" desc="Circuit Number or Name" group="" helpmode="Append">
            <value><![CDATA[1]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="TE" desc="Electrical Torque (pu)" group="" helpmode="Append" content_type="Variable" intent="Input" min="" max="" dim="1" unit="">
            <value><![CDATA[TE]]></value>
            <cond><![CDATA[(Model==2)||(Model==4)||(Model==5)||(Model==11)||(Model==17)||(Model==18)||(Model==19)||(Model==20)||(Model==22)]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="MBASE" desc="Machine Base MVA" group="" helpmode="Append" content_type="Variable" intent="Input" min="" max="" dim="1" unit="MVA">
            <value><![CDATA[120.0]]></value>
            <cond><![CDATA[(Model==4)||(Model==5)||(Model==20)||(Model==22)]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="SBASE" desc="System Base MVA" group="" helpmode="Append" content_type="Variable" intent="Input" min="" max="" dim="1" unit="MVA">
            <value><![CDATA[100.0]]></value>
            <cond><![CDATA[(Model==5)]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="TI" desc="Time to Initiate Fast Valving (sec)" group="" helpmode="Append" content_type="Variable" intent="Input" min="" max="" dim="1" unit="sec">
            <value><![CDATA[10000.0]]></value>
            <cond><![CDATA[(Model==14)||(Model==15)]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
      </form>
