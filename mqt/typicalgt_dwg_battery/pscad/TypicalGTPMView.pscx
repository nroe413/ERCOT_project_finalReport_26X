    <Definition classid="UserCmpDefn" name="Electranix_PSSE_Exciter_Models" group="" url="" version="" build="" crc="70384053" instances="1" view="false" date="0" id="510733563">
      <paramlist>
        <param name="Description" value="PSSE Compatible Exciter Models" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Main Data" visible="true">
          <cond />
          <parameter type="Text" name="FName" desc="Full pathname of input .DYR file:" group="" helpmode="Append" allowemptystr="True">
            <value><![CDATA[..\inputfile.dyr]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Choice" name="Model" desc="Exciter Model" group="" helpmode="Append">
            <value><![CDATA[48]]></value>
            <regex />
            <error_msg />
            <help />
            <cond />
            <choice><![CDATA[55 = AC1C]]></choice>
            <choice><![CDATA[56 = AC2C]]></choice>
            <choice><![CDATA[57 = AC3C]]></choice>
            <choice><![CDATA[58 = AC4C]]></choice>
            <choice><![CDATA[59 = AC5C]]></choice>
            <choice><![CDATA[60 = AC6C]]></choice>
            <choice><![CDATA[48 = AC7B]]></choice>
            <choice><![CDATA[61 = AC7C]]></choice>
            <choice><![CDATA[50 = AC8B]]></choice>
            <choice><![CDATA[62 = AC8C]]></choice>
            <choice><![CDATA[63 = AC9C]]></choice>
            <choice><![CDATA[64 = BBSEX1]]></choice>
            <choice><![CDATA[52 = DC3A]]></choice>
            <choice><![CDATA[53 = DC4B]]></choice>
            <choice><![CDATA[65 = DC4C]]></choice>
            <choice><![CDATA[54 = EMAC1T]]></choice>
            <choice><![CDATA[0 = ESAC1A]]></choice>
            <choice><![CDATA[1 = ESAC2A]]></choice>
            <choice><![CDATA[2 = ESAC3A]]></choice>
            <choice><![CDATA[3 = ESAC4A]]></choice>
            <choice><![CDATA[4 = ESAC5A]]></choice>
