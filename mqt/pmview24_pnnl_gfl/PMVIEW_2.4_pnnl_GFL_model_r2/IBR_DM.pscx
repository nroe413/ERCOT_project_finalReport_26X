          </parameter>
          <parameter type="Integer" name="XlTable" desc="Impedance Correction Table #" group="" helpmode="Append" content_type="Literal" intent="Input" min="-1" max="100000" dim="1" unit="">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[(Tap!=0) || (PHSHFT==1)]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="XlFactor" desc="Real Impedance Correction Factor (obtained from Tables for a given Tap/Angle)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="2" dim="1" unit="p.u.">
            <value><![CDATA[1.0]]></value>
            <cond><![CDATA[(Tap!=0) || (PHSHFT==1)]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="XlFactj" desc="Imag. Impedance Correction Factor (obtained from Tables for a given Tap/Angle)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="2" dim="1" unit="p.u.">
            <value><![CDATA[0.0]]></value>
            <cond><![CDATA[(Tap!=0) || (PHSHFT==1)]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="GI" desc="GI - Real Shunt Admittance on bus I (pu)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="" dim="1" unit="p.u.">
            <value><![CDATA[0.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="BI" desc="BI - Imag. Shunt Admittance on bus I (pu, -ve for L)" group="" helpmode="Append" content_type="Literal" intent="Input" min="" max="" dim="1" unit="p.u.">
            <value><![CDATA[0.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="GJ" desc="GJ - Real Shunt Admittance on bus J (pu)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="" dim="1" unit="p.u.">
            <value><![CDATA[0.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="BJ" desc="BJ - Imag. Shunt Admittance on bus J (pu, -ve for L)" group="" helpmode="Append" content_type="Literal" intent="Input" min="" max="" dim="1" unit="p.u.">
            <value><![CDATA[0.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
        <category name="Saturation">
          <parameter type="Choice" name="Enab" desc="Enable Saturation?" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = No (can be enabled from a snapshot)]]></choice>
            <choice><![CDATA[1 = Yes]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="Sat" desc="Place saturation on winding:" group="" helpmode="Append">
            <value><![CDATA[1]]></value>
            <choice><![CDATA[1 = #1]]></choice>
            <choice><![CDATA[2 = #2]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Xair" desc="Air core reactance (pu)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.001" max="10" dim="1" unit="p.u.">
            <value><![CDATA[0.2]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Tdc" desc="Inrush decay time constant (sec)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.001" max="" dim="1" unit="sec">
            <value><![CDATA[1.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Xknee" desc="Knee voltage(pu)" group="" helpmode="Append" content_type="Literal" intent="Input" min="" max="" dim="1" unit="p.u.">
            <value><![CDATA[1.25]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Txk" desc="Time to release flux clipping" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="1e+006" dim="1" unit="sec">
            <value><![CDATA[0.1]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Im1" desc="Magnetizing current" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="50" dim="1" unit="%">
            <value><![CDATA[0.4]]></value>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
        <category name="Monitoring of Currents and Flux">
          <parameter type="Text" name="IL1" desc="Name for winding #1 line currents (kA,into winding, not including inrush current)" group="" helpmode="Append">
            <value><![CDATA[]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Text" name="IL2" desc="Name for winding #2 line currents (kA,into winding, not including inrush current)" group="" helpmode="Append">
            <value><![CDATA[]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Text" name="IMAG" desc="Name for magnetizing currents (kA)" group="" helpmode="Append">
            <value><![CDATA[]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Text" name="FLUX" desc="Name for flux linkages (kWb-N)" group="" helpmode="Append">
            <value><![CDATA[]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
        </category>
      </form>
      <script>
        <segment name="Computations" id="563782030" classid="CoreSegment"><![CDATA[INTEGER Type1=((View==2)||(PHSHFT==1)) ? 0 : ((Config1==0||Config1==3||Config1==4) ? 0 : (Config1==1||Config1==5||Config1==8) ? 1 : 2)
INTEGER Type2=((View==2)||(PHSHFT==1)) ? 0 : ((Config2==0||Config2==3||Config2==4) ? 0 : (Config2==1||Config2==5||Config2==8) ? 1 : 2)
INTEGER NType1 = ((Config1==0||Config1==1||Config1==2) ? 0 : ((Config1==3||Config1==5||Config1==6) ? 1 : 2))
INTEGER NType2 = ((Config2==0||Config2==1||Config2==2) ? 0 : ((Config2==3||Config2==5||Config2==6) ? 1 : 2))
INTEGER NCW = -2
REAL    PSAngle = -PSANG
REAL 	 ANGMFD = (PSANG >= 0.0 ? (PSANG > 180.0 ? -(360.0-PSANG):PSANG) : (PSANG > -180.0 ? PSANG:(360.0+PSANG)))
INTEGER PSZone = (ANGMFD >= 0.0 ? ((ANGMFD < 60.0) ? 0 : 1) : ((ANGMFD > -60.0) ? 0 : 2))
REAL 	 NwAngle = (PSZone == 0 ? ANGMFD : (PSZone == 1 ? (ANGMFD-120.0) : (ANGMFD+120.0)))
INTEGER txTYPE = (((ABS(Rw)>0)&&(V5Format==0))||((Xl<0)&&(NegXCap==1)) ? 0 : ((ABS(Rw)>0)&&(V5Format!=0)) ? 1 : 2)
INTEGER ANG1 = ~
 #CASE Config1 {~0~}{~-30~}{~30~}{~120~}{~-120~}{~90~}{~150~}{~-90~}{~-150~}
INTEGER ANG2 = ~
 #CASE Config2 {~0~}{~-30~}{~30~}{~120~}{~-120~}{~90~}{~150~}{~-90~}{~-150~}
REAL    phDIFF = ((PHSHFT==1)? PSANG : ANG1-ANG2)
REAL    N1x = (PHSHFT==1)&&(View!=2) ? cos(abs(NwAngle)*pi/180.0) : 1.0
REAL    N2x = (PHSHFT==1)&&(View!=2) ? sin(abs(NwAngle)*pi/180.0) : 1.0
REAL    V1x=(Type1==0) ? V1LL/sqrt(3.0) : V1LL
REAL    V2x=(Type2==0) ? V2LL/sqrt(3.0) : V2LL
REAL    V1 = ((Tap==0)||(Tap==2)) ? V1x : V1x
REAL    V2 = ((Tap==0)||(Tap==1)) ? V2x : V2x
REAL    Tmva=Tmva3/3.0
REAL    Xlcorrf= ((Tap!=0)||(PHSHFT==1)) ? XlFactor : 1.0
REAL    Xlcorrfj= ((Tap!=0)||(PHSHFT==1)) ? XlFactj : 0.0
REAL    xlnew = ((Xl>0.0)||(NegXCap==0)) ? Xl : 0.000001
REAL    xlmod = xlnew/(N1x*N1x)
REAL    xlc = xlnew*Xlcorrf + Rw*Xlcorrfj
REAL    rwc = Rw*Xlcorrf - xlnew*Xlcorrfj
REAL    I_m1= Im1*0.01
REAL    I_m2= I_m1
REAL    w   = 2*pi*f
REAL    ib1 = Tmva/V1
REAL    zb1 = V1/ib1
REAL	 tr  = V1/(V2*N1x)
REAL    l1  = w/(xlc*zb1)
REAL    l2  = tr*tr*l1
REAL    l12 = -tr*l1
REAL    PSxlc = 0.00001
REAL    PSV1 = V2LL*N1x
REAL    PSV2 = V2LL/sqrt(3.0)
REAL    PSib1 = Tmva/PSV1
REAL    PSzb1 = PSV1/PSib1
REAL	 PStr  = (NwAngle!=0.0) ? PSV1/(PSV2*N2x) : 0.0
REAL    PSl1  = w/(PSxlc*PSzb1)
REAL    PSl2  = PStr*PStr*PSl1
REAL    PSl12 = -PStr*PSl1
REAL    ZBASE1   = (V1LL*V1LL)/Tmva3
REAL    ZBASE2   = (V2LL*V2LL)/Tmva3
REAL    YBASE1   = Tmva3/(V1LL*V1LL)
REAL    YBASE2   = Tmva3/(V2LL*V2LL)
REAL    Rw1      = 0.5*rwc*ZBASE1
REAL    Rw2      = 0.5*rwc*ZBASE2
REAL    Rw1D     = (V5Format==0) ? Rw1 : 0.0
REAL    Rw2D     = (V5Format==0) ? Rw2 : 0.0
REAL    Cw1      = ((Xl>0.0)||(NegXCap==0)) ? 0.0 : (1.0e6*2.0)/(-Xl*ZBASE1*w)
REAL    Cw2      = ((Xl>0.0)||(NegXCap==0)) ? 0.0 : (1.0e6*2.0)/(-Xl*ZBASE2*w)
REAL    CShunt1  = B>0  ? (1.0e6/2.0)*B/(ZBASE1*w)   : 0.0
REAL    CShunt2  = B>0  ? (1.0e6/2.0)*B/(ZBASE2*w)   : 0.0
REAL    LShunt1  = B<0  ? 2.0*(ZBASE1/(-B))/w        : 0.0
REAL    LShunt2  = B<0  ? 2.0*(ZBASE2/(-B))/w        : 0.0
REAL    RShuntI  = ((GI>1.0e-10)||(GI<(-1.0e-10)))  ? 1.0/(GI*YBASE1) : 0.0
REAL    CShuntI  = BI>0  ? (1.0e6)*BI/(ZBASE1*w)     : 0.0
REAL    LShuntI  = BI<0  ? (ZBASE1/(-BI))/w          : 0.0
REAL    RShuntJ  = ((GJ>1.0e-10)||(GJ<(-1.0e-10)))  ? 1.0/(GJ*YBASE2) : 0.0
REAL    CShuntJ  = BJ>0  ? (1.0e6)*BJ/(ZBASE2*w)     : 0.0
REAL    LShuntJ  = BJ<0  ? (ZBASE2/(-BJ))/w          : 0.0
REAL    Rw1V5    = Rw1>=1.0E-6 ? (Type1==0 ? Rw1 : (3.0*Rw1)) : 0.0
REAL    Rw2V5    = Rw2>=1.0E-6 ? (Type2==0 ? Rw2 : (3.0*Rw2)) : 0.0]]></segment>
        <segment name="Transformers" id="1638462991" classid="CoreSegment"><![CDATA[#IF Enable==1
C   PSSE Compatible Single Phase Transformer:   $Tmva3 MVA, $V1LL kV,LL : $V2LL kV,LL
#IF PHSHFT==0
C Normal Transformer (not phase shifters) 
 #IF View==2
  #TRANSFORMERS 1
  #WINDINGS 2
 #ELSE
  #TRANSFORMERS 3
  #WINDINGS 2
 #ENDIF
 #IF (((ABS(Rw)>0)&&(V5Format==0))||((Xl<0)&&(NegXCap==1)))
C Winding R,C > 0.0
  #IF View==0
C 3 Phase
  $NCW / Number of windings...
   #IF Type1==0  
    #CASE NType1 { $A1 0   $l1 /}{ $B1 0   $l1 /}{ $C1 0   $l1 /} 
   #ELSEIF Type1==1  
    #CASE NType1 { $A1 $B1   $l1 /}{ $B1 $C1   $l1 /}{ $C1 $A1   $l1 /}
   #ELSE  
    #CASE NType1 { $A1 $C1   $l1 /}{ $B1 $A1   $l1 /}{ $C1 $B1   $l1 /}
   #ENDIF
   #IF Type2==0  
    #CASE NType2 { $A2 0   $l12  $l2 /}{ $B2 0   $l12  $l2 /}{ $C2 0   $l12  $l2 /} 
   #ELSEIF Type2==1  
    #CASE NType2 { $A2 $B2   $l12  $l2 /}{ $B2 $C2   $l12  $l2 /}{ $C2 $A2   $l12  $l2 /}
   #ELSE  
