        <line x1="-49" y1="-49" x2="-40" y2="-49" stroke="Black" stroke-width="0.2" stroke-dasharray="None" port="" />
        <cond><![CDATA[true]]></cond>
        <line x1="-55" y1="36" x2="-72" y2="36" stroke="Black" stroke-width="0.2" stroke-dasharray="None" port="" />
        <line x1="-54" y1="0" x2="-72" y2="0" stroke="Black" stroke-width="0.2" stroke-dasharray="None" port="" />
