            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="Comp" desc="Voltage Compounding Model:" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = none (control local VTerminal)]]></choice>
            <choice><![CDATA[1 = COMP ( Vc = Vt + jX * I )]]></choice>
            <choice><![CDATA[2 = COMPCC]]></choice>
            <choice><![CDATA[3 = IEEEVC ( Vc = Vt + (R + jX) * I )]]></choice>
            <choice><![CDATA[4 = REMCMP (Control a Remote Bus Voltage)]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
