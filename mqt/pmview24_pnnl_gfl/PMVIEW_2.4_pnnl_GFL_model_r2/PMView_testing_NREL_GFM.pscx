    <Definition classid="UserCmpDefn" name="Electranix_xfmr_2w_1" group="" url="" version="" build="" crc="94126103" instances="2" view="false" date="0" id="876295500">
      <paramlist>
        <param name="Description" value="PSSE Compatible 2 winding transformer" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Configuration">
          <parameter type="Text" name="Name" desc="Transformer Name" group="" helpmode="Append">
            <value><![CDATA[T1]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Tmva3" desc="Transformer MVA (3 phase)" group="" helpmode="Append" content_type="Literal" intent="Input" min="1e-006" max="" dim="1" unit="MVA">
            <value><![CDATA[100]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="f" desc="Base Frequency (Hz)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="" dim="1" unit="Hz">
            <value><![CDATA[60]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="V1LL" desc="Winding #1 Volts (kV,L-L,rms)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="" dim="1" unit="kV">
            <value><![CDATA[230]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="V2LL" desc="Winding #2 Volts (kV,L-L,rms)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="" dim="1" unit="kV">
            <value><![CDATA[230]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Rw" desc="R - Winding Resistance (pu)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="" dim="1" unit="p.u.">
            <value><![CDATA[0.01]]></value>
            <help><![CDATA[]]></help>
          </parameter>
