    <Definition classid="UserCmpDefn" name="Current_Limiter_Scale" group="" url="" version="" build="" crc="20969746" instances="0" key="" view="false" date="1772677285" id="835159537">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Device Name" name="Name" group="" type="Text" helpmode="Append" allowemptystr="True">
            <value />
            <cond />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter desc="Device Rating" name="Sn" group="General" unit="kVA*MVA" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1.5]]></value>
            <cond />
            <help><![CDATA[Adjust rating units accordingly]]></help>
          </parameter>
          <parameter desc="Rating Units" name="cur_base" group="General" type="Choice" helpmode="Append">
            <value><![CDATA[0]]></value>
            <cond />
            <help><![CDATA[Select correct units of device rating]]></help>
            <choice><![CDATA[0 = MVA]]></choice>
            <choice><![CDATA[1 = kVA]]></choice>
          </parameter>
          <parameter desc="Base Voltage (L-L, RMS)" name="V_Base" group="General" unit="kV" min="0" max="500" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[12.47]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Enable" name="cur_enable" group="General" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Current Limit" name="cur_limit" group="General" unit="p.u." min="0" max="1.5" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1.0]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Real Power Axis" name="Power_axis" group="Specifications" type="Choice" helpmode="Append">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
            <choice><![CDATA[0 = D Axis]]></choice>
            <choice><![CDATA[1 = Q Axis]]></choice>
          </parameter>
          <parameter desc="Q Direction" name="Q_direct" group="Specifications" type="Choice" helpmode="Append">
            <value><![CDATA[0]]></value>
            <cond />
            <help><![CDATA[Polarity of Q axis, influences negative power permitting]]></help>
            <choice><![CDATA[0 = Leading]]></choice>
            <choice><![CDATA[1 = Lagging]]></choice>
          </parameter>
          <parameter desc="Negative Real Power" name="Neg_power" group="Specifications" type="Choice" helpmode="Append">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
            <choice><![CDATA[0 = Prohibited]]></choice>
            <choice><![CDATA[1 = Permitted]]></choice>
          </parameter>
          <parameter desc="Filter Capacitance" name="Cap_x_pu" group="Specifications" unit="pu" min="-1e+308" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[Cf_in]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Filter Capacitor Limit Compensation" name="cap_comp" group="Specifications" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Internal Voltage RMS L-L" name="Vint_rms" group="" unit="" min="-1e+308" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[Vint_DG]]></value>
            <cond />
            <help />
          </parameter>
        </category>
      </form>
