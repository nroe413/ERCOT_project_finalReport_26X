    <Definition classid="UserCmpDefn" name="Electranix_xfmr_2w" group="" url="" version="" build="" crc="28162468" instances="2" view="false" date="0" id="24302346">
      <paramlist>
        <param name="Description" value="PSSE Compatible 2 winding transformer" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Configuration">
          <parameter type="Text" name="Name" desc="Transformer Name" group="" helpmode="Append">
            <value><![CDATA[T1]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Tmva3" desc="Transformer MVA (3 phase)" group="" helpmode="Append" content_type="Literal" intent="Input" min="1e-006" max="" dim="1" unit="MVA">
            <value><![CDATA[100]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="f" desc="Base Frequency (Hz)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="" dim="1" unit="Hz">
            <value><![CDATA[60]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="V1LL" desc="Winding #1 Volts (kV,L-L,rms)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="" dim="1" unit="kV">
            <value><![CDATA[230]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="V2LL" desc="Winding #2 Volts (kV,L-L,rms)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="" dim="1" unit="kV">
            <value><![CDATA[230]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Rw" desc="R - Winding Resistance (pu)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="" dim="1" unit="p.u.">
            <value><![CDATA[0.01]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Xl" desc="X - Leakage Reactance (pu)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="" dim="1" unit="p.u.">
            <value><![CDATA[0.1]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="B" desc="B - Susceptance (pu)" group="" helpmode="Append" content_type="Literal" intent="Input" min="" max="" dim="1" unit="p.u.">
            <value><![CDATA[0.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="View" desc="Circuit Type?" group="" helpmode="Append">
            <value><![CDATA[1]]></value>
            <choice><![CDATA[0 = Three Phase]]></choice>
            <choice><![CDATA[1 = Three Phase Single Line (V4)]]></choice>
            <choice><![CDATA[2 = Single Phase]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="PHSHFT" desc="Is this a Phase Shifter?" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = No]]></choice>
            <choice><![CDATA[1 = Yes]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="Config1" desc="Winding 1 Config / Phase Rotation on Clock-Hour" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = Star Gnd (0 [0°])]]></choice>
            <choice><![CDATA[3 = Star Gnd (4 [120°])]]></choice>
            <choice><![CDATA[4 = Star Gnd (8 [-120°])]]></choice>
            <choice><![CDATA[1 = Delta (11 [-30°])]]></choice>
            <choice><![CDATA[2 = Delta (1 [30°])]]></choice>
            <choice><![CDATA[5 = Delta (3 [90°])]]></choice>
            <choice><![CDATA[6 = Delta (5 [150°])]]></choice>
            <choice><![CDATA[7 = Delta (9 [-90°])]]></choice>
            <choice><![CDATA[8 = Delta (7 [-150°])]]></choice>
