!
#COMPONENTID
      CALL PNNL_REGFMDyn_Begin($Mbase_PNNL, $Vbase_PNNL, $L1_pu, $R1_pu,
     + $L2_pu, $R2_pu, $LC_frequency, $Tbrk, $wFlag, $Vdrp_Flag, $QV_Flag, $PQFlag,
     + $FFlag, $ESFlag, $Enable_Plant_Ctrl, $Preq, $Wset_pu, $mP, $dwmax, $dwmin,
     + $Tp, $H, $D1, $D2, $wD, $mQ, $Kpv, $Kiv, $Wbase, $Vreq, $Qreq, $kp_PLL,
     + $ki_PLL, $dwPLLmax, $dwPLLmin, $Vpllfrz, $TPF, $TQF, $TVf, $TIf, $Imax,
     + $kf, $kI, $I_maxF, $ke, BR_IDX, ND_IDX, $SS)
!
