    <Definition classid="UserCmpDefn" name="PNNL_REGFM" id="601452000" group="" url="" version="" build="" crc="114295478" view="false" date="0">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <script>
        <segment name="Dsdyn" id="1068404510" classid="CoreSegment"><![CDATA[#STORAGE LOGICAL:25 INTEGER:60 REAL:176 STOR:20 RTCL:2 RTCI:182 RTCF:26 STXFRI:9 STXFRF:457 
#BEGIN
#LOCAL INTEGER BR_IDX
#LOCAL INTEGER ND_IDX
!
      RTCI(NRTCI) = $BRN1
      RTCI(NRTCI + 1) = $BRN2
      RTCI(NRTCI + 2) = $BRN3
      RTCI(NRTCI + 3) = $BRN4
