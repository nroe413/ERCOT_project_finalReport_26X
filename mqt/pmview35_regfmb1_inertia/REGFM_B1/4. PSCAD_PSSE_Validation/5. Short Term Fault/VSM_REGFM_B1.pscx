      <form name="PNNL REGFM_B1: Control Parameters and Flags" w="699" h="667" splitter="80" commentlines="4" help-width="490" category-width="180">
        <category name="Base Values" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="Mbase_PNNL" desc="M_base: Base power rating for inverter controller (MVA)" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="MVA" min="0.1" max="5000">
            <value><![CDATA[100]]></value>
            <cond><![CDATA[]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Vbase_PNNL" desc="V_base: Base voltage rating for inverter controller (kV)" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="kV" min="0.1" max="1000">
            <value><![CDATA[230]]></value>
            <cond><![CDATA[]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
        <category name="Inverter Main Circuit" visible="true" splitter="71">
          <cond><![CDATA[true]]></cond>
          <parameter name="L1_pu" desc="L1: Inverter-side filter inductance (pu)" type="Real" group="LCL Filter Parameters" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="pu" min="0.01" max="0.5">
            <value><![CDATA[0.09]]></value>
            <cond><![CDATA[]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[ ]]></help>
          </parameter>
          <parameter name="R1_pu" desc="R1: Inverter-side filter resistance (pu)" type="Real" group="LCL Filter Parameters" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="pu" min="0" max="0.1">
            <value><![CDATA[0.02]]></value>
            <cond><![CDATA[]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="L2_pu" desc="L2: Grid-side filter inductance (pu)" type="Real" group="LCL Filter Parameters" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="pu" min="0.01" max="0.5">
            <value><![CDATA[0.01]]></value>
            <cond><![CDATA[]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="R2_pu" desc="R2: Grid-side filter resistamce (pu)" type="Real" group="LCL Filter Parameters" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="pu" min="0.0001" max="0.1">
            <value><![CDATA[0.0001]]></value>
            <cond><![CDATA[]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="LC_frequency" desc="fc: Cut-off Frequency (Hz)" type="Real" group="LCL Filter Parameters" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="Hz" min="100" max="5000">
            <value><![CDATA[600]]></value>
            <cond><![CDATA[]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Tbrk" desc="Tbrk: Time instance to close breakers for grid connection (s)" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="s" min="0" max="100">
