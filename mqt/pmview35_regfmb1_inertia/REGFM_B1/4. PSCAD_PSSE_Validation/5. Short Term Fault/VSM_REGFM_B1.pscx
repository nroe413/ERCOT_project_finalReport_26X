      RTCI(NRTCI + 11) = $BRN12
      RTCI(NRTCI + 12) = $BRN13
      RTCI(NRTCI + 13) = $BRN14
      RTCI(NRTCI + 14) = $BRN15
      RTCI(NRTCI + 15) = $BRN16
