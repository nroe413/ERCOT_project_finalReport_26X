      RTCI(NRTCI + 23) = $BRN24
      RTCI(NRTCI + 24) = $BRN25
      RTCI(NRTCI + 25) = $BRN26
      RTCI(NRTCI + 26) = $BRN27
      RTCI(NRTCI + 27) = $BRN28
      RTCI(NRTCI + 28) = $BRN29
      RTCI(NRTCI + 29) = $BRN30
      RTCI(NRTCI + 30) = $BRN31
      RTCI(NRTCI + 31) = $BRN32
      RTCI(NRTCI + 32) = $BRN33
      RTCI(NRTCI + 33) = $BRN34
      RTCI(NRTCI + 34) = $BRN35
      RTCI(NRTCI + 35) = $BRN36
      RTCI(NRTCI + 36) = $BRN37
      RTCI(NRTCI + 37) = $BRN38
      RTCI(NRTCI + 38) = $BRN39
      RTCI(NRTCI + 39) = $BRN40
      RTCI(NRTCI + 40) = $BRN41
      RTCI(NRTCI + 41) = $BRN42
      RTCI(NRTCI + 42) = $BRN43
!
      BR_IDX = NRTCI
      NRTCI = NRTCI + 43
!
      RTCI(NRTCI) = $GND
      RTCI(NRTCI + 1) = $A
      RTCI(NRTCI + 2) = $B
      RTCI(NRTCI + 3) = $C
      RTCI(NRTCI + 4) = $NBBS(1)
      RTCI(NRTCI + 5) = $NBBS(2)
      RTCI(NRTCI + 6) = $NBBS(3)
      RTCI(NRTCI + 7) = $NBBS(4)
      RTCI(NRTCI + 8) = $NBBS(5)
      RTCI(NRTCI + 9) = $NBBS(6)
      RTCI(NRTCI + 10) = $NBBS(7)
      RTCI(NRTCI + 11) = $NBBS(8)
      RTCI(NRTCI + 12) = $NBBS(9)
      RTCI(NRTCI + 13) = $NBBS(10)
      RTCI(NRTCI + 14) = $NBBS(11)
      RTCI(NRTCI + 15) = $NBBS(12)
      RTCI(NRTCI + 16) = $NBBS(13)
      RTCI(NRTCI + 17) = $NBBS(14)
      RTCI(NRTCI + 18) = $NBBS(15)
      RTCI(NRTCI + 19) = $NBBS(16)
      RTCI(NRTCI + 20) = $NBBS(17)
      RTCI(NRTCI + 21) = $NBBS(18)
      RTCI(NRTCI + 22) = $NBBF(1)
      RTCI(NRTCI + 23) = $NBBS(19)
      RTCI(NRTCI + 24) = $NBBS(20)
      RTCI(NRTCI + 25) = $NBBS(21)
      RTCI(NRTCI + 26) = $NBBS(22)
      RTCI(NRTCI + 27) = $NBBS(23)
      RTCI(NRTCI + 28) = $NBBS(24)
      RTCI(NRTCI + 29) = $NBBS(25)
      RTCI(NRTCI + 30) = $NBBS(26)
      RTCI(NRTCI + 31) = $NBBS(27)
      RTCI(NRTCI + 32) = $NBBF(2)
      RTCI(NRTCI + 33) = $NBBF(3)
      RTCI(NRTCI + 34) = $NBBF(4)
      RTCI(NRTCI + 35) = $NBBF(5)
