        <segment name="Dsdyn" id="1509356761" classid="CoreSegment"><![CDATA[#STORAGE LOGICAL:18 INTEGER:40 REAL:889 RTCI:95 RTCF:21 STXFRI:4 STXFRF:248 
#BEGIN
#LOCAL INTEGER BR_IDX
#LOCAL INTEGER ND_IDX
!
      RTCI(NRTCI) = $BRN1
      RTCI(NRTCI + 1) = $BRN2
      RTCI(NRTCI + 2) = $BRN3
