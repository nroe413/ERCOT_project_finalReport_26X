      <form name="PNNL REGFM_A1: Parameters and Flags" w="723" h="600" splitter="80" commentlines="4" help-width="490" category-width="200">
        <category name="Base Values" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="Mbase_PNNL" desc="Mbase: Base power rating for REGFM_A1 controller (in MVA)" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="MVA" min="0" max="3000">
            <value><![CDATA[0.1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Vbase_PNNL" desc="Vbase: Base voltage rating for REGFM_A1 controller (in kV)" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="kV" min="0" max="10">
            <value><![CDATA[0.48]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
        <category name="Inverter Main Circuit" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="L1_pu" desc="L1: Inverter main circuit filter inductance (in pu)" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="10">
            <value><![CDATA[0.15]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="R1_pu" desc="R1: Inverter main circuit filter inductor resistance (in pu)" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="10">
            <value><![CDATA[0.03]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="R2_pu" desc="R2: Inverter main circuit filter capacitor resistance (in pu)" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="10">
            <value><![CDATA[0.003]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="LC_frequency" desc="LC_frequency:Inverter main circuit filter resonance frequency (in Hz)" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="0" max="3000">
            <value><![CDATA[600]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
        <category name="REGFM_A1 Outerloop Parameters" visible="true" splitter="80">
          <cond><![CDATA[true]]></cond>
          <parameter name="mQ" desc="mq: Q-V droop gain (in pu)" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1">
            <value><![CDATA[0.05]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Vreq" desc="Vref: Voltage set point (in pu) " type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="2">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Qreq" desc="Qref: Reactive power set point (in pu)" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="-1" max="1">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="kpv" desc="kpv: Proportional gain of the voltage controller (in pu)" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="kiv" desc="kiv: Integral gain of the voltage controller (in pu/s)" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu/s" min="0" max="20">
            <value><![CDATA[5.86]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
