    <Definition classid="UserCmpDefn" name="SCR" group="" url="" version="" build="" crc="122865344" instances="0" key="" view="false" date="1776825707" id="979148982">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Base Voltage (L-L, RMS)" name="Vn" group="" unit="kV" min="0" max="2000" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[345]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Base Frequency" name="Fn" group="" unit="Hz" min="50" max="60" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[60]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Generator Maximum Power" name="Pmax" group="" unit="MW" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[100]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Time to Start SCR Test" name="T0" group="" unit="sec" min="0" max="1000" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[5]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Time to Finish SCR Test" name="Tf" group="" unit="" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Maximum/Initial SCR" name="SCRmax" group="General" unit="" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[10]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Minimum/Final SCR" name="SCRmin" group="" unit="" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[2]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Ramp Down Option" name="RampDownFlag" group="" type="Choice" helpmode="Append">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[SCRmax>SCRmin&&Tf>T0]]></cond>
            <help><![CDATA[SCR Profile: profile_SCR.txt]]></help>
            <choice><![CDATA[0 = Step Change]]></choice>
            <choice><![CDATA[1 = Continuous Change]]></choice>
            <choice><![CDATA[2 = SCR Profile]]></choice>
          </parameter>
          <parameter desc="Ramp Down Steps" name="Nsteps" group="" unit="" min="0" max="2147483647" content_type="Literal" type="Integer" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[8]]></value>
            <cond><![CDATA[RampDownFlag==0&&SCRmax>SCRmin]]></cond>
            <help />
          </parameter>
          <parameter desc="Fault Type" name="FLTtype" group="" type="Choice" helpmode="Append">
            <value><![CDATA[11]]></value>
            <cond />
            <help />
            <choice><![CDATA[11 = 3P Fault]]></choice>
            <choice><![CDATA[0 = No Fault]]></choice>
          </parameter>
          <parameter desc="Fault Interval (for Continous Change)" name="Tfi" group="" unit="" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value />
            <cond><![CDATA[RampDownFlag==1&&(FLTtype==11||FLTtype==1)]]></cond>
            <help />
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -200 200 200" size="4">
