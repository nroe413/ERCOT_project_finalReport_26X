        <User classid="UserCmp" name="PSCADView:PMView" id="1987210183" x="540" y="234" w="100" h="100" z="30" orient="0" defn="PSCADView:PMView" link="-1" q="4" disable="false">
          <paramlist link="-1" name="" crc="43565601">
