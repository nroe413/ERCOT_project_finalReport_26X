        <Sticky classid="Sticky" id="838293485" x="18" y="900" w="450" h="90" colors="0, 15792890">
          <paramlist>
            <param name="full_font" value="Tahoma, 9pt" />
            <param name="align" value="0" />
            <param name="style" value="1" />
            <param name="font" value="1" />
            <param name="fg_color" value="0" />
            <param name="bg_color" value="15792890" />
            <param name="arrows" value="2" />
            <param name="opacity" value="25" />
            <param name="fg_color_adv" value="#FF000000" />
            <param name="bg_color_adv" value="#FFFAFAF0" />
            <param name="hl_color_adv" value="#FFFFFF00" />
            <param name="bdr_color_adv" value="#FF95918C" />
          </paramlist><![CDATA[This logic controls the pass-through breakers BRK2A and BRK2B.  If "inj_dur" = 0 then the external input is allowed to pass-through until it is time to apply the series of transients from time T0 and lasting 4.0 seconds.  If "inj_dur" = 1 then no pass-through is permitted and the internal source is always enabled.  If "enabl" = 0 then this block is disabled and will only pass-through.]]></Sticky>
        <User classid="UserCmp" name="master:datalabel" id="1540193504" x="432" y="1098" w="34" h="23" z="1" orient="0" defn="master:datalabel" link="-1" q="4" disable="false">
