            <value><![CDATA[0]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Wind or Solar 2800 LVRT curve" name="ibr_type" group="" type="Choice" helpmode="Append">
            <value><![CDATA[0]]></value>
            <cond>
            </cond>
            <help><![CDATA[Select between LVRT curves]]></help>
            <choice><![CDATA[0 = Wind]]></choice>
            <choice><![CDATA[1 = Solar / Storage]]></choice>
          </parameter>
          <parameter desc="Transient HVRT enable" name="trans_enable" group="" type="Choice" helpmode="Append">
            <value><![CDATA[0]]></value>
            <cond>
            </cond>
            <help><![CDATA[Enable transient on 2800 HVRT]]></help>
            <choice><![CDATA[0 = off]]></choice>
            <choice><![CDATA[1 = on]]></choice>
          </parameter>
        </category>
      </form>
