        </User>
        <Sticky classid="Sticky" id="451195750" x="18" y="180" w="342" h="108" colors="0, 15792890">
          <paramlist>
            <param name="full_font" value="Tahoma, 9pt" />
            <param name="align" value="0" />
            <param name="style" value="1" />
            <param name="font" value="1" />
            <param name="fg_color" value="0" />
            <param name="bg_color" value="15792890" />
            <param name="arrows" value="1" />
            <param name="opacity" value="25" />
            <param name="fg_color_adv" value="#FF000000" />
            <param name="bg_color_adv" value="#FFFAFAF0" />
            <param name="hl_color_adv" value="#FFFFFF00" />
            <param name="bdr_color_adv" value="#FF95918C" />
          </paramlist><![CDATA[BRK2A is pass-through and is closed by default.  2A is opened and 2B is closed to apply the transients.  Setting inj_dur determines whether pass-through is permitted when the transient isn't actively being applied or whether this voltage source always outputs.]]></Sticky>
