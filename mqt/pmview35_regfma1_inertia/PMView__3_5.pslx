      <script>
        <segment name="Computations" id="476147265" classid="CoreSegment"><![CDATA[	REAL :: t]]></segment>
        <segment name="Fortran" id="645162967" classid="CoreSegment"><![CDATA[	#LOCAL REAL t
	#LOCAL REAL P0
	#LOCAL REAL Energy        

        Energy = STORF(NSTORF)
        P0 = STORF(NSTORF+1)

        $InertiaEst = 0

        IF ($profile .EQ. $inertiaTestNum) THEN

                t = TIME - $T0
                IF (t .LT. $t1) THEN

                        $freqProf = $fn
                        Energy = 0
                        $InertiaEst = 0
                        P0 = $P_Main

                ELSEIF (t .LT. $t1+($f1end-$fn)/$rocof1) THEN
                        $freqProf  = $fn + $rocof1*(t-$t1)

                        Energy = Energy + ($P_Main- P0)*DELT
                        $InertiaEst = 0.5*$fn*(Energy/$Pmax)/((t-$t1)*$rocof1)

                ELSEIF (t .LT. $t2) THEN
                        $freqProf = $f1end
                ELSEIF (t .LT. $t2+($f2end-$f1end)/$rocof2) THEN
                        $freqProf = $f1end + $rocof2*(t-$t2)

                ELSEIF (t .LT. $t3) THEN
                        $freqProf = $f2end
                ELSEIF (t .LT. $t3+($f3end-$f2end)/$rocof3) THEN
                        $freqProf = $f2end + $rocof3*(t-$t3)

                ELSEIF (t .LT. $t4) THEN
                        $freqProf = $f3end
                ELSEIF (t .LT. $t4+($f4end-$f3end)/$rocof4) THEN
                        $freqProf = $f3end + $rocof4*(t-$t4)

                ELSEIF (t .LT. $t5) THEN
                        $freqProf = $f4end
                ELSEIF (t .LT. $t5+($f5end-$f4end)/$rocof5) THEN
                        $freqProf = $f4end + $rocof5*(t-$t5)

                ELSEIF (t .LT. $t6) THEN
                        $freqProf = $f5end
                ELSEIF (t .LT. $t6+($f6end-$f5end)/$rocof6) THEN
                        $freqProf = $f5end + $rocof6*(t-$t6)

                ELSEIF (t .LT. $t7) THEN
                        $freqProf = $f6end
                ELSEIF (t .LT. $t7+($f7end-$f6end)/$rocof7) THEN
                        $freqProf = $f6end + $rocof7*(t-$t7)

                ELSE
                        $freqProf = $f7end
                ENDIF

        ELSE
                $freqProf = $fn
                Energy = 0
                $InertiaEst =0

        ENDIF

        IF ($InertiaEst .LT. 0) THEN
                $InertiaEst = -1*$InertiaEst 
        ENDIF


        STORF(NSTORF) = Energy
        STORF(NSTORF+1) = P0
        NSTORF = NSTORF + 2]]></segment>
        <segment name="Branch" id="455171126" classid="CoreSegment"><![CDATA[]]></segment>
      </script>
    </Definition>
