    <Definition classid="UserCmpDefn" name="SCR" group="" url="" version="" build="" crc="71771766" instances="0" key="" view="false" date="1781713924" id="1217369833">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60" commentlines="4" help-width="490">
        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Base Voltage (L-L, RMS)" name="Vn" group="" unit="kV" min="0" max="2000" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[345]]></value>
            <cond />
            <help />
            <vis />
            <animate />
          </parameter>
          <parameter desc="Base Frequency" name="Fn" group="" unit="Hz" min="50" max="60" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[60]]></value>
            <cond />
            <help />
            <vis />
            <animate />
          </parameter>
          <parameter desc="Generator Maximum Power" name="Pmax" group="" unit="MW" min="0" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[100]]></value>
            <cond />
            <help />
            <vis />
            <animate />
          </parameter>
          <parameter desc="Time to Start SCR Test" name="T0" group="" unit="sec" min="0" max="1000" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[5]]></value>
            <cond />
            <help />
            <vis />
            <animate />
          </parameter>
          <parameter desc="Time to Finish SCR Test" name="Tf" group="" unit="" min="0" max="1E+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
            <vis />
            <animate />
          </parameter>
          <parameter desc="Maximum/Initial SCR" name="SCRmax" group="General" unit="" min="0" max="1E+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[10]]></value>
            <cond />
            <help />
            <vis />
            <animate />
          </parameter>
          <parameter desc="Minimum/Final SCR" name="SCRmin" group="" unit="" min="0" max="1E+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[2]]></value>
            <cond />
            <help />
            <vis />
            <animate />
          </parameter>
          <parameter desc="Ramp Down Option" name="RampDownFlag" group="" type="Choice" helpmode="Append" animate="false">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[SCRmax>SCRmin&&Tf>T0]]></cond>
            <help><![CDATA[SCR Profile: profile_SCR.txt]]></help>
            <vis />
            <choice cond=""><![CDATA[0 = Step Change]]></choice>
            <choice cond=""><![CDATA[1 = Continuous Change]]></choice>
            <choice cond=""><![CDATA[2 = SCR Profile]]></choice>
          </parameter>
          <parameter desc="Ramp Down Steps" name="Nsteps" group="" unit="" min="0" max="2147483647" content_type="Literal" type="Integer" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[8]]></value>
            <cond><![CDATA[RampDownFlag==0&&SCRmax>SCRmin]]></cond>
            <help />
            <vis />
            <animate />
          </parameter>
          <parameter desc="Fault Type" name="FLTtype" group="" type="Choice" helpmode="Append" animate="false">
            <value><![CDATA[11]]></value>
            <cond />
            <help />
            <vis />
            <choice cond=""><![CDATA[11 = 3P Fault]]></choice>
            <choice cond=""><![CDATA[0 = No Fault]]></choice>
          </parameter>
          <parameter desc="Fault Interval (for Continous Change)" name="Tfi" group="" unit="sec" min="0" max="1E+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[100]]></value>
            <cond><![CDATA[RampDownFlag==1&&(FLTtype==11||FLTtype==1)]]></cond>
            <help />
            <vis />
            <animate />
          </parameter>
          <parameter name="AGSESR_scr_testNum" desc="AGSESR_scr_test" type="Integer" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="" min="-2147483648" max="2147483647">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
            <animate />
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -200 200 200" size="4">
        <port model="Natural" name="i1_right" x="90" y="0" dim="3" mode="Electrical" type="NonRemovable" internal="false"><![CDATA[true]]></port>
        <cond><![CDATA[true]]></cond>
        <rect x="-32" y="-22" width="105" height="34" stroke="Black" stroke-width="0.2" stroke-dasharray="none" fill-style="Solid" fill-fg="Lime" fill-bg="Black" />
        <line x1="90" y1="0" x2="72" y2="0" stroke="Black" stroke-width="0.2" stroke-dasharray="none" port="" />
        <text x="60" y="-20" stroke="Black" font-size="Small" text-anchor="Middle"><![CDATA[]]></text>
        <text x="22" y="-9" stroke="Black" font-size="Medium" text-anchor="Middle"><![CDATA[SCR Test]]></text>
        <text x="21" y="6" stroke="Black" font-size="Small" text-anchor="Middle"><![CDATA[Short Ckt Ratio]]></text>
      </svg>
