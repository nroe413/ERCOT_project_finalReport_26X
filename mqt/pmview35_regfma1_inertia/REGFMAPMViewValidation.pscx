    <Definition classid="UserCmpDefn" name="PMView" group="" url="" version="" build="" crc="19197605" instances="0" key="" view="false" date="1781713924" id="1910697102">
      <paramlist name="">
        <param name="Description" value="PSCAD Model Tester" />
      </paramlist>
      <form name="PSCAD Model Tester" w="320" h="400" splitter="60" commentlines="4" help-width="490">
        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Name" name="Name" group="" type="Text" helpmode="Append" allowemptystr="true" min="0" max="0">
            <value />
            <cond />
            <help />
            <regex />
            <error_msg />
            <vis />
          </parameter>
          <parameter desc="Time delay" name="T0" group="" unit="sec" min="-1E+308" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Wind or Solar LVRT curve" name="ibr_type" group="" type="Choice" helpmode="Append" animate="false">
            <value><![CDATA[0]]></value>
            <cond />
            <help><![CDATA[Select between LVRT curves]]></help>
            <vis />
            <choice><![CDATA[0 = Wind]]></choice>
            <choice><![CDATA[1 = Solar / Storage]]></choice>
          </parameter>
          <parameter name="Vratedpu" desc="Rated Voltage" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="kV" min="-1E+308" max="1E+308">
            <value><![CDATA[345]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Prated" desc="Rated MW" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="MW" min="-1E+308" max="1E+308">
            <value><![CDATA[100]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
