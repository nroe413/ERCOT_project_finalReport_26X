        <segment name="Dsdyn" id="451261617" classid="CoreSegment"><![CDATA[#STORAGE LOGICAL:18 INTEGER:40 REAL:889 RTCI:95 RTCF:21 STXFRI:4 STXFRF:248 
#BEGIN
