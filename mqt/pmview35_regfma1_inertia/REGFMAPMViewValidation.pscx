        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Name" name="Name" group="" type="Text" helpmode="Append" allowemptystr="true" min="0" max="0">
            <value />
            <cond />
            <help />
            <regex />
            <error_msg />
            <vis />
          </parameter>
          <parameter desc="Base Voltage (L-L, RMS)" name="VRated" group="" unit="kV" min="0" max="2000" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[345]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Base Frequency" name="Fn" group="" unit="Hz" min="50" max="60" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[60]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Specify if PMU voltage in pu" name="pmu_in_pu" group="" type="Choice" helpmode="Append" animate="false">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
            <vis />
            <choice><![CDATA[0 = PMU Actual Units]]></choice>
            <choice><![CDATA[1 = PMU per-unit]]></choice>
          </parameter>
          <parameter desc="Undervoltage Scale Threshold" name="Vuv_thres" group="" unit="pu" min="0" max="2" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0]]></value>
            <cond />
            <help><![CDATA[Scales PMU V measurements that are below a certain pu threshold (0 to disable)]]></help>
            <vis />
          </parameter>
          <parameter desc="Undervoltage scale coefficient" name="Vuv_coeff" group="" unit="" min="0" max="2" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[1]]></value>
            <cond />
            <help><![CDATA[Lower voltage PMU measurements will be scaled by this factor before playback]]></help>
            <vis />
          </parameter>
        </category>
      </form>
