            <help><![CDATA[Time to]]></help>
          </parameter>
          <parameter desc="DFR Injection Duration (s)" name="ti_duration" group="" unit="s" min="-1e+308" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0]]></value>
            <cond />
            <help><![CDATA[Must be less than or equal to the length of DFR data available.]]></help>
          </parameter>
          <parameter desc="DFR scale factor" name="dfr_scale" group="" unit="" min="-1e+308" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1]]></value>
            <cond />
