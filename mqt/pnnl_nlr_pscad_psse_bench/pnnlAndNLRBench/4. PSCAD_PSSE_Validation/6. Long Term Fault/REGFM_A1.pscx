        <segment name="Dsdyn" id="1829922086" classid="CoreSegment"><![CDATA[#STORAGE LOGICAL:18 INTEGER:40 REAL:889 RTCI:95 RTCF:21 STXFRI:4 STXFRF:248 
#BEGIN
#LOCAL INTEGER BR_IDX
#LOCAL INTEGER ND_IDX
!
      RTCI(NRTCI) = $BRN1
      RTCI(NRTCI + 1) = $BRN2
      RTCI(NRTCI + 2) = $BRN3
      RTCI(NRTCI + 3) = $BRN4
      RTCI(NRTCI + 4) = $BRN5
      RTCI(NRTCI + 5) = $BRN6
      RTCI(NRTCI + 6) = $BRN7
      RTCI(NRTCI + 7) = $BRN8
      RTCI(NRTCI + 8) = $BRN9
      RTCI(NRTCI + 9) = $BRN10
      RTCI(NRTCI + 10) = $BRN11
      RTCI(NRTCI + 11) = $BRN12
      RTCI(NRTCI + 12) = $BRN13
      RTCI(NRTCI + 13) = $BRN14
      RTCI(NRTCI + 14) = $BRN15
      RTCI(NRTCI + 15) = $BRN16
      RTCI(NRTCI + 16) = $BRN17
      RTCI(NRTCI + 17) = $BRN18
      RTCI(NRTCI + 18) = $BRN19
      RTCI(NRTCI + 19) = $BRN20
      RTCI(NRTCI + 20) = $BRN21
      RTCI(NRTCI + 21) = $BRN22
!
      BR_IDX = NRTCI
      NRTCI = NRTCI + 22
!
      RTCI(NRTCI) = $GND
      RTCI(NRTCI + 1) = $A
      RTCI(NRTCI + 2) = $B
      RTCI(NRTCI + 3) = $C
      RTCI(NRTCI + 4) = $NBBS(1)
      RTCI(NRTCI + 5) = $NBBS(2)
      RTCI(NRTCI + 6) = $NBBS(3)
      RTCI(NRTCI + 7) = $NBBS(4)
      RTCI(NRTCI + 8) = $NBBS(5)
      RTCI(NRTCI + 9) = $NBBS(6)
      RTCI(NRTCI + 10) = $NBBS(7)
      RTCI(NRTCI + 11) = $NBBS(8)
      RTCI(NRTCI + 12) = $NBBS(9)
      RTCI(NRTCI + 13) = $NBBS(10)
      RTCI(NRTCI + 14) = $NBBS(11)
      RTCI(NRTCI + 15) = $NBBS(12)
      RTCI(NRTCI + 16) = $NBBS(13)
      RTCI(NRTCI + 17) = $NBBS(14)
      RTCI(NRTCI + 18) = $NBBS(15)
      RTCI(NRTCI + 19) = $NBBS(16)
      RTCI(NRTCI + 20) = $NBBF
!
      ND_IDX = NRTCI
      NRTCI = NRTCI + 21
!
#COMPONENTID
      CALL PNNL_REGFM_A1Dyn_Begin($Mbase_PNNL, $Vbase_PNNL, $Wbase, $VFlag,
     + $I0_Flag, $Enable_Plant_Ctrl, $QVFlag, BR_IDX, ND_IDX, $SS)
!
#ENDBEGIN
#LOCAL INTEGER BR_IDX
#LOCAL INTEGER ND_IDX
!
      BR_IDX = NRTCI
      NRTCI = NRTCI + 22
!
      ND_IDX = NRTCI
      NRTCI = NRTCI + 21
!
#COMPONENTID
      CALL PNNL_REGFM_A1Dyn($Pref_ext, $Qref_ext, $Vref_ext, $Mbase_PNNL,
     + $Vbase_PNNL, $L1_pu, $R1_pu, $R2_pu, $LC_frequency, $mQ, $Vreq, $Qreq,
     + $kpv, $kiv, $Emax, $Emin, $mP, $Preq, $Pmax, $Pmin, $kppmax, $kipmax, $Wbase,
     + $TPf, $TQf, $TVf, $Qmax, $Qmin, $kpqmax, $kiqmax, $VFlag, $I_Kp, $XL_pu,
     + $Rv_pu, $I0_Flag, $I_clip, $ImaxF, $Enable_Plant_Ctrl, $QVFlag, $V_pu,
     + $P_pu, $Q_pu, $I_pu, $f_drp, $E_drp, BR_IDX, ND_IDX, $SS)
!
]]></segment>
