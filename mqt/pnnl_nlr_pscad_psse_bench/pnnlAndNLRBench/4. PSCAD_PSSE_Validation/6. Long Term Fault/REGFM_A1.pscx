BRN18 = $NBBS(16)  $NBBS(15)  BREAKER  1.0  0.0  0.0
BRN19 = $GND  $NBBF    1.0  0.0  0.0
BRN20 = $NBBF  $NBBS(4)  SOURCE  1.0  0.1  1.0
BRN21 = $NBBF  $NBBS(2)  SOURCE  1.0  0.1  1.0
BRN22 = $NBBF  $NBBS(5)  SOURCE  1.0  0.1  1.0
]]></segment>
