        <segment name="Branch" id="721961650" classid="CoreSegment"><![CDATA[BRN1 = $NBBS(10)  $A  AMMETER      
BRN2 = $NBBS(14)  $C  AMMETER      
BRN3 = $NBBS(12)  $B  AMMETER      
BRN4 = $NBBS(7)  $NBBS(10)  AMMETER      
