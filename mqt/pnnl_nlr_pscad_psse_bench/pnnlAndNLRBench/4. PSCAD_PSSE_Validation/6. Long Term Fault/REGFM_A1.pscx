BRN7 = $NBBS(1)  $NBBS(2)  BREAKER  1.0  0.0  0.0
BRN8 = $NBBS(3)  $NBBS(4)  BREAKER  1.0  0.0  0.0
BRN9 = $NBBS(5)  $NBBS(6)  BREAKER  1.0  0.0  0.0
BRN10 = $NBBS(1)  $NBBS(7)  BREAKER  1.0  0.0  0.0
