          </parameter>
          <parameter desc="Propotional Gain" name="Kp" group="" unit="Ohm" min="-1e+308" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[Kp_current_int]]></value>
            <cond />
            <help><![CDATA[Not per unit! Unpack in main module]]></help>
          </parameter>
          <parameter desc="Integral Gain" name="Ki" group="" unit="Ohm/s" min="-1e+308" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[Ki_current_int]]></value>
            <cond />
            <help><![CDATA[Not per unit! Unpack in main module]]></help>
          </parameter>
          <parameter desc="Q Orientation" name="Q_orient" group="" type="Choice" helpmode="Append">
            <value><![CDATA[1]]></value>
            <cond />
            <help><![CDATA[Influences decoupling terms only]]></help>
            <choice><![CDATA[0 = Q Lagging]]></choice>
            <choice><![CDATA[1 = Q Leading]]></choice>
          </parameter>
          <parameter desc="Filter Inductance" name="Lf" group="" unit="H" min="-1e+308" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[Lf]]></value>
            <cond />
            <help><![CDATA[Inductance value, not per unitized. Unpack in main module]]></help>
          </parameter>
        </category>
      </form>
