            <cond />
            <help />
          </parameter>
          <parameter desc="Coupling Resistance" name="Rc_in" group="Physical Setpoint" unit="pu" min="0" max="100" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.005]]></value>
