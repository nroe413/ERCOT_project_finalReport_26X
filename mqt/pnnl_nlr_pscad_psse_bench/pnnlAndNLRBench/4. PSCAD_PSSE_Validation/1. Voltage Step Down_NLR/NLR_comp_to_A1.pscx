      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Name" name="Name" group="" type="Text" helpmode="Append" allowemptystr="True">
            <value />
            <cond />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter desc="Current Feedforward Gain" name="G_ff_i" group="" unit="" min="0" max="2" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[G_ff_i]]></value>
            <cond />
            <help><![CDATA[Current feedforward gain]]></help>
          </parameter>
          <parameter desc="Decoupling Frequency" name="Decouple_rad_freq" group="" unit="radian/s" min="-1e+308" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[Rad_Freq]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Proportional Gain" name="Kp" group="" unit="1/Ohm" min="-1e+308" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[Kp_voltage_int]]></value>
            <cond />
            <help><![CDATA[Not per unit! Unpack in main module]]></help>
          </parameter>
          <parameter desc="Integral Gain" name="Ki" group="" unit="Ohm/s" min="-1e+308" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[Ki_voltage_int]]></value>
            <cond />
            <help><![CDATA[Not per unit! Unpack in main module]]></help>
          </parameter>
          <parameter desc="Q Orientation" name="Q_orient" group="" type="Choice" helpmode="Append">
            <value><![CDATA[1]]></value>
            <cond />
            <help><![CDATA[Influences decoupling terms only]]></help>
            <choice><![CDATA[0 = Q Lagging]]></choice>
            <choice><![CDATA[1 = Q Leading]]></choice>
          </parameter>
          <parameter desc="Filter Capacitance" name="Cf" group="" unit="uF" min="-1e+308" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[Cf]]></value>
            <cond />
            <help><![CDATA[Capacitance value, not per unitized, in micro Farad!. Unpack in main module]]></help>
          </parameter>
        </category>
