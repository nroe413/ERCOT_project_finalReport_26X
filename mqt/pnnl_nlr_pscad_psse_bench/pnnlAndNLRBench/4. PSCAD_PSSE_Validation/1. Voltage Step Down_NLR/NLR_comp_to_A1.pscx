    <Definition classid="UserCmpDefn" name="GFM_Inverter_Dev4" group="" url="" version="" build="" crc="75400281" instances="0" key="" view="false" date="1777347006" id="765298886">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Name" name="Name" group="" type="Text" helpmode="Append" allowemptystr="True">
            <value />
            <cond />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter desc="Base Frequency" name="f_base" group="" unit="Hz" min="0" max="100" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[60]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Base Power" name="s_base" group="" unit="kVA" min="0" max="1000000" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Base Voltage" name="v_base" group="" unit="kV" min="0" max="1000" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.20785]]></value>
            <cond />
            <help><![CDATA[L-L voltage of inverter]]></help>
          </parameter>
          <parameter desc="Real Power Set Point" name="p_ref_pu" group="General" unit="pu" min="0" max="1.1" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.0]]></value>
            <cond />
            <help><![CDATA[Only used if starting as GFL]]></help>
          </parameter>
          <parameter desc="Release Time" name="Release_Time" group="Synchronization" unit="s" min="0" max="100" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Voltage/Reactive Power Control" name="VQ_Control" group="General" type="Choice" helpmode="Append">
            <value><![CDATA[0]]></value>
            <cond />
            <help><![CDATA[Reactive Power Droop, or Voltage Regulation with PI Controller]]></help>
            <choice><![CDATA[0 = Reactive Droop]]></choice>
            <choice><![CDATA[1 = Voltage Regulation]]></choice>
          </parameter>
          <parameter desc="Reactive Power Set Point" name="q_ref_pu" group="General" unit="pu" min="-1.0" max="1.0" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.0]]></value>
            <cond />
            <help><![CDATA[If acting as reactive droop, achieves this operating point before release]]></help>
          </parameter>
          <parameter desc="Voltage Set Point" name="v_ref_pu" group="" unit="pu" min="0" max="1.5" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1.0]]></value>
            <cond />
            <help><![CDATA[Voltage reference if tracking a voltage set point]]></help>
          </parameter>
          <parameter desc="Power Calculation" name="p_calc" group="General" type="Choice" helpmode="Append">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
            <choice><![CDATA[0 = Capacitor Voltage]]></choice>
            <choice><![CDATA[1 = Grid Voltage]]></choice>
          </parameter>
          <parameter desc="Virtual Resistor" name="VR_enable" group="General" type="Choice" helpmode="Append">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
            <choice><![CDATA[0 = Disable]]></choice>
            <choice><![CDATA[1 = Enable]]></choice>
          </parameter>
          <parameter desc="AVR Release Delay" name="Tavr_release" group="Synchronization" unit="s" min="0" max="10" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.2]]></value>
            <cond />
            <help><![CDATA[If using AVR, engaged after primary release plus this delay.]]></help>
          </parameter>
          <parameter desc="Reactive Set Point Delay" name="Q_set_delay" group="Synchronization" unit="s" min="0" max="100" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.5]]></value>
            <cond />
            <help><![CDATA[Upon completed real power ramp, additional delay to adjust voltage for reactive power]]></help>
          </parameter>
          <parameter desc="Real Power Set Point Delay" name="P_set_delay" group="Synchronization" unit="s" min="0" max="100" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.5]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Real Power Set Point Rate" name="P_set_rate" group="Synchronization" unit="%/s" min="0" max="10" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1.0]]></value>
            <cond />
            <help />
          </parameter>
        </category>
