    <Definition classid="UserCmpDefn" name="Electranix_Init_Conditions" group="" url="" version="" build="" crc="123946899" instances="1" view="false" date="0" id="822485706">
      <paramlist>
        <param name="Description" value="Initial Conditions from Loadflow" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Main Data">
          <parameter type="Choice" name="Type" desc="Branch Type/Initial Conditions Location" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = Branch to Ground]]></choice>
            <choice><![CDATA[-1 = Series Device, Left Side]]></choice>
            <choice><![CDATA[1 = Series Device, Right Side]]></choice>
            <choice><![CDATA[2 = Machine to Ground]]></choice>
            <choice><![CDATA[3 = 3 Winding Xfmr, Tertiary]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="Shift" desc="Phase Shift of this Bus" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[-1 = - 30 degree phase shift]]></choice>
            <choice><![CDATA[0 = No phase shift]]></choice>
            <choice><![CDATA[1 = 30 degree phase shift]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="NumMac" desc="Number of Parallel Machines" group="" helpmode="Append" content_type="Literal" intent="Input" min="" max="" dim="1" unit="">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[Type==2]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Volts" desc="Bus Voltage Magnitude from Loadflow (pu)" group="" helpmode="Append" content_type="Literal" intent="Input" min="" max="" dim="1" unit="pu">
            <value><![CDATA[1.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Phase" desc="Bus Phase Angle from Loadflow (deg)" group="" helpmode="Append" content_type="Literal" intent="Input" min="" max="" dim="1" unit="deg">
            <value><![CDATA[0.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="P" desc="Bus P Power Flow from Loadflow (total MW out of this bus)" group="" helpmode="Append" content_type="Literal" intent="Input" min="" max="" dim="1" unit="MW">
            <value><![CDATA[0.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Q" desc="Bus Q Power Flow from Loadflow (total MVAR out of this bus)" group="" helpmode="Append" content_type="Literal" intent="Input" min="" max="" dim="1" unit="MVAR">
            <value><![CDATA[0.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -200 200 200" size="4">
        <port model="Transfer" name="VOut" x="72" y="-36" dim="1" mode="Output" type="Real" internal=""><![CDATA[true]]></port>
        <port model="Transfer" name="QOut" x="72" y="18" dim="1" mode="Output" type="Real" internal=""><![CDATA[true]]></port>
        <port model="Transfer" name="AOut" x="72" y="-18" dim="1" mode="Output" type="Real" internal=""><![CDATA[true]]></port>
        <port model="Transfer" name="POut" x="72" y="0" dim="1" mode="Output" type="Real" internal=""><![CDATA[true]]></port>
        <cond><![CDATA[Type==0]]></cond>
        <line x1="55" y1="-36" x2="71" y2="-36" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="" />
        <cond><![CDATA[Type==2]]></cond>
        <line x1="55" y1="-36" x2="71" y2="-36" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="" />
        <cond><![CDATA[Type==0]]></cond>
        <line x1="55" y1="-18" x2="71" y2="-18" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="" />
        <cond><![CDATA[Type==2]]></cond>
        <line x1="55" y1="-18" x2="71" y2="-18" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="" />
        <cond><![CDATA[Type==0]]></cond>
        <line x1="55" y1="0" x2="71" y2="0" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="" />
        <cond><![CDATA[Type==2]]></cond>
        <line x1="55" y1="0" x2="71" y2="0" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="" />
        <cond><![CDATA[Type==0]]></cond>
        <line x1="55" y1="18" x2="71" y2="18" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="" />
        <cond><![CDATA[Type==2]]></cond>
        <line x1="55" y1="18" x2="71" y2="18" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="" />
        <cond><![CDATA[true]]></cond>
        <rect x="-88" y="-69" width="143" height="99" stroke="Fuchsia" stroke-dasharray="none" stroke-width="0.4" fill-style="Hollow" fill-fg="Black" fill-bg="" port="" />
        <line x1="55" y1="-36" x2="72" y2="-36" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="VOut" />
        <line x1="55" y1="-18" x2="72" y2="-18" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="AOut" />
        <line x1="55" y1="0" x2="72" y2="0" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="POut" />
        <line x1="55" y1="18" x2="72" y2="18" stroke="Black" stroke-dasharray="none" stroke-width="ByNode" port="QOut" />
        <text x="54" y="-13" stroke="Black" fill="Black" font-size="Small" text-anchor="End"><![CDATA[Angle(deg)]]></text>
        <text x="54" y="4" stroke="Black" fill="Black" font-size="Small" text-anchor="End"><![CDATA[Pout(MW)]]></text>
        <text x="54" y="22" stroke="Black" fill="Black" font-size="Small" text-anchor="End"><![CDATA[Qout(MVAR)]]></text>
        <text x="-87" y="-13" stroke="Black" fill="Black" font-size="Small" text-anchor="Start"><![CDATA[$Phase]]></text>
        <text x="-87" y="4" stroke="Black" fill="Black" font-size="Small" text-anchor="Start"><![CDATA[$P]]></text>
        <text x="-87" y="22" stroke="Black" fill="Black" font-size="Small" text-anchor="Start"><![CDATA[$Q]]></text>
        <text x="-16" y="42" stroke="Black" fill="Black" font-size="Small" text-anchor="Middle"><![CDATA[Initial Conditions from Loadflow]]></text>
        <cond><![CDATA[Shift==1]]></cond>
        <text x="-7" y="-13" stroke="Black" fill="Black" font-size="Small" text-anchor="End"><![CDATA[(+30)]]></text>
        <cond><![CDATA[Type==-1]]></cond>
        <text x="-30" y="-58" stroke="Black" fill="Black" font-size="Small" text-anchor="Start"><![CDATA[Left Bus]]></text>
        <cond><![CDATA[Type==1]]></cond>
        <text x="-30" y="-58" stroke="Black" fill="Black" font-size="Small" text-anchor="Start"><![CDATA[Right Bus]]></text>
        <cond><![CDATA[true]]></cond>
        <text x="-82" y="-58" stroke="Black" fill="Black" font-size="Small" text-anchor="Middle"><![CDATA[E]]></text>
        <cond><![CDATA[Shift==-1]]></cond>
        <text x="-7" y="-13" stroke="Black" fill="Black" font-size="Small" text-anchor="End"><![CDATA[(-30)]]></text>
        <cond><![CDATA[true]]></cond>
        <text x="54" y="-31" stroke="Black" fill="Black" font-size="Small" text-anchor="End"><![CDATA[Volts(pu)]]></text>
        <text x="-87" y="-31" stroke="Black" fill="Black" font-size="Small" text-anchor="Start"><![CDATA[$Volts]]></text>
        <cond><![CDATA[Type==2]]></cond>
        <text x="-42" y="3" stroke="Black" fill="Black" font-size="Small" text-anchor="Start"><![CDATA[ / $NumMac]]></text>
        <text x="-42" y="22" stroke="Black" fill="Black" font-size="Small" text-anchor="Start"><![CDATA[ / $NumMac]]></text>
        <cond><![CDATA[Type==3]]></cond>
        <text x="-42" y="-58" stroke="Black" fill="Black" font-size="Small" text-anchor="Start"><![CDATA[Tertiary Bus]]></text>
      </svg>
      <script>
        <segment name="Fortran" id="1077941806" classid="CoreSegment"><![CDATA[! Electranix Initialization Component
      $VOut = $Volts
#IF ( Shift==1 )
      $AOut = $Phase + 30.0
#ELSEIF ( Shift==-1 )
      $AOut = $Phase - 30.0
#ELSE
      $AOut = $Phase
#ENDIF
#IF ( Type==2 )
      $POut = $P/$NumMac
      $QOut = $Q/$NumMac
#ELSE
      $POut = $P
      $QOut = $Q
#ENDIF]]></segment>
        <segment name="Branch" id="761217276" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Computations" id="1430317446" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Help" id="1639382500" classid="CoreSegment"><![CDATA[E-TRAN_Model_Help\E-TRAN008.htm#SubChapter_ETRAN_Initialize]]></segment>
        <segment name="FlyBy" id="1791215939" classid="CoreSegment"><![CDATA[
Electranix - Initial Conditions

- Transfers Loadflow Terminal Conditions to this component
so it can be used to initialize custom models.
- E-TRAN also reads in the phase shift (-30,0 or +30)
(the offset is added to the loadflow angle before it is
written to the machine model - this handles the phase shifts
from wye-delta transformers)]]></segment>
      </script>
