      RTCI(NRTCI + 14) = $NBBS(11)
      RTCI(NRTCI + 15) = $NBBS(12)
      RTCI(NRTCI + 16) = $NBBS(13)
      RTCI(NRTCI + 17) = $NBBS(14)
      RTCI(NRTCI + 18) = $NBBS(15)
      RTCI(NRTCI + 19) = $NBBS(16)
      RTCI(NRTCI + 20) = $NBBF
!
      ND_IDX = NRTCI
      NRTCI = NRTCI + 21
!
#COMPONENTID
      CALL PNNL_REGFM_A1Out_Begin($Mbase_PNNL, $Vbase_PNNL, $Wbase, $VFlag,
     + $I0_Flag, $Enable_Plant_Ctrl, $QVFlag, BR_IDX, ND_IDX, $SS)
!
#ENDBEGIN
#LOCAL INTEGER BR_IDX
#LOCAL INTEGER ND_IDX
!
      BR_IDX = NRTCI
      NRTCI = NRTCI + 22
!
      ND_IDX = NRTCI
      NRTCI = NRTCI + 21
!
#COMPONENTID
      CALL PNNL_REGFM_A1Out(BR_IDX, ND_IDX, $SS)
!
]]></segment>
        <segment name="Branch" id="721961650" classid="CoreSegment"><![CDATA[BRN1 = $NBBS(10)  $A  AMMETER      
BRN2 = $NBBS(14)  $C  AMMETER      
BRN3 = $NBBS(12)  $B  AMMETER      
BRN4 = $NBBS(7)  $NBBS(10)  AMMETER      
BRN5 = $NBBS(8)  $NBBS(12)  AMMETER      
BRN6 = $NBBS(9)  $NBBS(14)  AMMETER      
BRN7 = $NBBS(1)  $NBBS(2)  BREAKER  1.0  0.0  0.0
BRN8 = $NBBS(3)  $NBBS(4)  BREAKER  1.0  0.0  0.0
BRN9 = $NBBS(5)  $NBBS(6)  BREAKER  1.0  0.0  0.0
BRN10 = $NBBS(1)  $NBBS(7)  BREAKER  1.0  0.0  0.0
BRN11 = $NBBS(3)  $NBBS(8)  BREAKER  1.0  0.0  0.0
BRN12 = $NBBS(6)  $NBBS(9)  BREAKER  1.0  0.0  0.0
BRN13 = $NBBS(10)  $NBBS(11)  BREAKER  1.0  0.0  0.0
BRN14 = $NBBS(12)  $NBBS(13)  BREAKER  1.0  0.0  0.0
BRN15 = $NBBS(14)  $NBBS(15)  BREAKER  1.0  0.0  0.0
BRN16 = $NBBS(16)  $NBBS(11)  BREAKER  1.0  0.0  0.0
BRN17 = $NBBS(16)  $NBBS(13)  BREAKER  1.0  0.0  0.0
BRN18 = $NBBS(16)  $NBBS(15)  BREAKER  1.0  0.0  0.0
BRN19 = $GND  $NBBF    1.0  0.0  0.0
BRN20 = $NBBF  $NBBS(4)  SOURCE  1.0  0.1  1.0
BRN21 = $NBBF  $NBBS(2)  SOURCE  1.0  0.1  1.0
BRN22 = $NBBF  $NBBS(5)  SOURCE  1.0  0.1  1.0
]]></segment>
