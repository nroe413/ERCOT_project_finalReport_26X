      CALL Electranix_PSSE_DC4C($Enab, $Bus, "$Ckt", $Comp, $VUEL, $VOEL, $Vref, $VIT, $VS, $EF0, $IFD, $EF, $VCOMP, "$FNAME")
#ELSEIF ( Model == 66 )
   #STORAGE STOR:14
   #STORAGE INTEGER:1
   #STORAGE LOGICAL:1
   #STORAGE REAL:23
      CALL Electranix_PSSE_IVOEX($Enab, $Bus, "$Ckt", $Comp, $VUEL, $VOEL, $Vref, $VIT, $VS, $EF0, $IFD, $EF, $VCOMP, "$FNAME")
#ELSE
      WRITE(6,*) "***ERROR: - Unsupported Exciter, Model: $Model"
      STOP
#ENDIF
