    <Definition classid="UserCmpDefn" name="Electranix_PSSE_Machine" group="" url="" version="" build="" crc="48925716" instances="1" view="false" date="0" id="589477992">
      <paramlist>
        <param name="Description" value="PSSE Compatible Synchronous Machine" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Configuration">
          <parameter type="Text" name="FName" desc="Full pathname of input .DYR file:" group="" helpmode="Append">
            <value><![CDATA[inputfile.dyr]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="Model" desc="Machine Model" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = GENCLS]]></choice>
            <choice><![CDATA[1 = GENDCO]]></choice>
            <choice><![CDATA[2 = GENROE]]></choice>
            <choice><![CDATA[3 = GENROU]]></choice>
            <choice><![CDATA[4 = GENSAE]]></choice>
            <choice><![CDATA[5 = GENSAL]]></choice>
            <choice><![CDATA[7 = GENTPJ*]]></choice>
            <choice><![CDATA[6 = GENTRA]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Integer" name="Bus" desc="Bus Number" group="" helpmode="Append" content_type="Literal" intent="Input" min="" max="" dim="1" unit="">
            <value><![CDATA[1000]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Text" name="Ckt" desc="Circuit Number or Name" group="" helpmode="Append">
            <value><![CDATA[1]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Integer" name="machsw" desc="Source[0] -&gt; Machine[1] transition" group="" helpmode="Append" content_type="Variable" intent="Input" min="0" max="1" dim="1" unit="0-&gt;1only">
            <value><![CDATA[1]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Integer" name="Enab" desc="Lock-rotor[0]&lt;-&gt;Normal mode[1] transition" group="" helpmode="Append" content_type="Variable" intent="Input" min="" max="" dim="1" unit="0or1">
            <value><![CDATA[1]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Vbase" desc="Rated RMS Voltage (kV,LL)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.01" max="" dim="1" unit="kV">
            <value><![CDATA[10.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="MVA" desc="Rated 3 Phase MVA" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.001" max="" dim="1" unit="MVA">
            <value><![CDATA[100.0]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Fbase" desc="Base Angular Frequency (Hz)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="" dim="1" unit="Hz">
            <value><![CDATA[60]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="MM" desc="Multimass interface:[Enables Speed Ctrl]" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = DISABLE]]></choice>
            <choice><![CDATA[1 = ENABLE]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="SAT" desc="Enable Saturation?" group="" helpmode="Append">
            <value><![CDATA[1]]></value>
            <choice><![CDATA[0 = No, Disable]]></choice>
            <choice><![CDATA[1 = Yes, Enabled]]></choice>
