         <param name="arrows" value="0" />
         <param name="fg_color" value="0" />
         <param name="bg_color" value="15792890" />
       </paramlist><![CDATA[Fault Location

0 = No Fault (Breaker Open)

Fault at 2(2) to 30(30) 230 kV Circuit 1
2 = Fault at 2
30 = Fault at 30

Fault at 6(6) to 31(31) 230 kV Circuit 1
6 = Fault at 6
31 = Fault at 31

Fault at 10(10) to 32(32) 230 kV Circuit 1
10 = Fault at 10
32 = Fault at 32

Fault at 11(11) to 12(12) 230 kV Circuit 1
11 = Fault at 11
12 = Fault at 12

Fault at 12(12) to 13(13) 230 kV Circuit 1
12 = Fault at 12
13 = Fault at 13

Fault at 19(19) to 20(20) 230 kV Circuit 1
19 = Fault at 19
20 = Fault at 20

Fault at 19(19) to 33(33) 230 kV Circuit 1
19 = Fault at 19
33 = Fault at 33

Fault at 20(20) to 34(34) 230 kV Circuit 1
20 = Fault at 20
34 = Fault at 34

Fault at 22(22) to 35(35) 230 kV Circuit 1
22 = Fault at 22
35 = Fault at 35

Fault at 23(23) to 36(36) 230 kV Circuit 1
23 = Fault at 23
36 = Fault at 36

Fault at 25(25) to 37(37) 230 kV Circuit 1
25 = Fault at 25
37 = Fault at 37

Fault at 29(29) to 38(38) 230 kV Circuit 1
29 = Fault at 29
38 = Fault at 38

]]></Sticky>
